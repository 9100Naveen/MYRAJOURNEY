<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- Camera settings -->
	<key>NSCameraReactionEffectGesturesEnabledDefault</key>
	<false/>

	<!--
	    App Transport Security (ATS)
	    ─────────────────────────────
	    NSExceptionDomains ONLY works with hostnames (e.g. "api.example.com").
	    Apple's ATS silently ignores raw IP addresses in that dictionary.
	    Because our backend is accessed via a bare IP (180.235.121.253) over
	    plain HTTP, NSAllowsArbitraryLoads=true is the ONLY key that actually
	    lifts the ATS block for IP-addressed servers.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

</dict>
</plist>
